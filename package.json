{
	"name": "fox-studio",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "cf dev",
		"build": "cf build",
		"deploy": "cf deploy",
		"typecheck": "cf workers types && tsc -p tsconfig.json && tsc -p tsconfig.browser.json && tsc -p tsconfig.tracking.json",
		"test": "vitest run --config vitest.config.ts",
		"test:e2e": "playwright test",
		"docker:start": "node scripts/docker.mjs start",
		"docker:stop": "node scripts/docker.mjs stop",
		"postinstall": "node scripts/sync-assets.mjs"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "beta",
		"@playwright/test": "1.63.0",
		"@types/node": "26.6.4",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@types/three": "0.186.0",
		"@vitejs/plugin-react": "6.1.1",
		"cf": "^1.0.0-beta.5",
		"typescript": "^7.0.2",
		"vite": "^8.3.0",
		"vitest": "5.0.3"
	},
	"dependencies": {
		"@cloudflare/containers": "0.3.7",
		"@cloudflare/streamline": "0.1.0",
		"@mediapipe/tasks-vision": "1.0.1",
		"jose": "6.2.12",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"three": "0.186.1"
	},
	"engines": {
		"node": ">=22.18.0"
	}
}
